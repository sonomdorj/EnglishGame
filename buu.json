{
  "intro": [
    {
      "who": "buu",
      "text": "I am Buu. I follow you.",
      "audio": "buu-65049287"
    },
    {
      "who": "buu",
      "text": "People here lie about days.",
      "audio": "buu-2954d958"
    },
    {
      "who": "buu",
      "text": "You are the judge.",
      "audio": "buu-57060ccc"
    },
    {
      "who": "buu",
      "text": "B opens the Family Book.",
      "audio": "buu-513f09d0"
    },
    {
      "who": "buu",
      "text": "Some things hide in the village.",
      "audio": "buu-d3f910ec"
    },
    {
      "who": "buu",
      "text": "Sometimes I say a wrong day.",
      "audio": "buu-4e3c1a31"
    },
    {
      "who": "buu",
      "text": "Then press F.",
      "audio": "buu-1767d94f"
    }
  ],
  "silly": {
    "who": "buu",
    "text": "You are right. I am a silly panda.",
    "audio": "buu-8279f9e1"
  },
  "nothingWrong": {
