{
  "intro": [
    {
      "who": "buu",
      "text": "I am Buu. I follow you.",
      "audio": "buu-65049287"
    },
    {
      "who": "buu",
      "text": "People here lie about days.",
      "audio": "buu-2954d958"
    },
    {
      "who": "buu",
      "text": "You are the judge.",
      "audio": "buu-57060ccc"
    },
    {
      "who": "buu",
      "text": "C opens the calendar.",
      "audio": "buu-f23f25c0"
    },
    {
      "who": "buu",
      "text": "B opens the Family Book.",
      "audio": "buu-513f09d0"
    },
    {
      "who": "buu",
      "text": "Lost things hide in the village.",
      "audio": "buu-0868e14a"
    },
    {
      "who": "buu",
      "text": "Sometimes I say a wrong day.",
      "audio": "buu-4e3c1a31"
    },
    {
      "who": "buu",
      "text": "Then press F.",
      "audio": "buu-1767d94f"
    }
  ],
